# ---- Outputs ----
# Published per run: the final test trials, val_metrics.txt and the listening examples
# (overrides *.wav above). FreeVC: synth-1..8, synth-1-align, synth-4-align. AGAIN-VC, DiffVC,
# wav2vec-VC: synth-1..8.
outputs/**
!outputs/**/
!outputs/*/synth-[1-8]/val_metrics.txt
!outputs/*/synth-[1-8]/test-final_trials_epoch*.tsv
!outputs/*/synth-[1-8]/examples/**
!outputs/freevc/synth-[14]-align/val_metrics.txt
!outputs/freevc/synth-[14]-align/test-final_trials_epoch*.tsv
!outputs/freevc/synth-[14]-align/examples/**
# VC quality of Test-9..16 is not part of the paper
analysis/results/vc_quality_*.tsv
!analysis/results/vc_quality_Test-[1-8].tsv
runs/
logs/
*.log
wandb/

